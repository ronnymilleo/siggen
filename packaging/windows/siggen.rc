#include <winver.h>

// The first icon of the executable: Explorer shows it, and SDL gives it to every window it creates
1 ICON "siggen.ico"

// The details Explorer lists in the file properties; CMake passes the version from project() in the root
// CMakeLists.txt, so every build carries the same product name and version
VS_VERSION_INFO VERSIONINFO
FILEVERSION SIGGEN_VERSION_MAJOR, SIGGEN_VERSION_MINOR, SIGGEN_VERSION_PATCH, 0
PRODUCTVERSION SIGGEN_VERSION_MAJOR, SIGGEN_VERSION_MINOR, SIGGEN_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ronny Milleo"
            VALUE "FileDescription", "siggen - Complex Baseband Signal Generator"
            VALUE "FileVersion", SIGGEN_VERSION
            VALUE "InternalName", "siggen"
            VALUE "LegalCopyright", "Copyright (C) Ronny Milleo, GPL-3.0"
            VALUE "OriginalFilename", "siggen.exe"
            VALUE "ProductName", "siggen"
            VALUE "ProductVersion", SIGGEN_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
