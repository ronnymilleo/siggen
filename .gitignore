# Build trees and their outputs
build*
cmake-build*
out/
# ...but not the packaging build scripts, matched by the build* pattern above
!packaging/**/build.sh

# Editors, IDEs and local state
.idea/
.vs/
.cache/
.ccache/
compile_commands.json
imgui.ini

# Local agent instructions and task data
/AGENTS.md
/CLAUDE.md
.nest/

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Presets written by the program, except the compiled-in examples
*.preset
!app-gui/examples/*.preset
