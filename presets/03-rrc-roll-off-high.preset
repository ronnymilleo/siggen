SymbolRateBaud=1000
SamplesPerSymbol=8
Pulse=RRC
RRCBeta=1.0
SpanSymbols=10
AmplitudeGain=1
DataSource=Random
Seed=5489
Bits=
NoiseSampleCount=2048
NoiseSampleRateHz=8000
NoisePower=1
AwgnEnabled=false
AwgnSnrDb=10
