[IQ Generator Preset]
# Lesson 1: a clean QPSK signal.
# Generate, then open Constellation > Matched filter: four tight points,
# EVM close to 0 and an open eye. This is the reference for every other lesson.
Version=2
Modulation=QPSK
NumberOfSymbols=256
SymbolRateBaud=1000
SamplesPerSymbol=8
Pulse=RRC
RRCBeta=0.2
SpanSymbols=10
AmplitudeGain=1
DataSource=Random
Seed=5489
Bits=
NoiseSampleCount=2048
NoiseSampleRateHz=8000
NoisePower=1
AwgnEnabled=false
AwgnSnrDb=10
NoiseSeed=5490
