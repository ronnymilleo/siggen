<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- UTF-8 as the code page of the process (Windows 10 1903 or newer): the narrow strings of std::filesystem,
     the preset files and the SigMF recordings then read and write file names in UTF-8, as SDL and Dear ImGui
     hand them -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
